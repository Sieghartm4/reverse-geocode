# Database Configuration for Reverse Geocoding API
# Copy this file to .env and update with your actual database settings

# Database name (default: ph_geodata)
DB_NAME=ph_geodata

# Database user (default: postgres)
DB_USER=postgres

# Database password (default: philippogi123)
DB_PASSWORD=

# Database host (default: localhost)
# For local development: localhost
# For remote server: your-server.com or IP address
DB_HOST=localhost

# Database port (default: 5432)
# For local PostgreSQL: 5432
# For remote server: check your PostgreSQL port
DB_PORT=5432

# Flask Server Configuration
# Change these to customize the API server

# Flask host (default: 127.0.0.1)
# Local development: 127.0.0.1
# Production server: 0.0.0.0 (binds to all interfaces)
FLASK_HOST=127.0.0.1

# Flask port (default: 5111)
# Change to any available port you prefer
FLASK_PORT=5111

# Flask debug mode (default: True)
# Development: True
# Production: False
FLASK_DEBUG=True

# Example configurations:
# 
# Local development:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5111
# FLASK_DEBUG=True
#
# Remote server:
# DB_HOST=your-db-server.com
# DB_PORT=5432
# DB_USER=your_remote_user
# DB_PASSWORD=your_remote_password
# FLASK_HOST=0.0.0.0
# FLASK_PORT=8080
# FLASK_DEBUG=False
#
# Cloud database (AWS RDS, Google Cloud SQL, etc.):
# DB_HOST=your-cloud-db.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=your_cloud_user
# DB_PASSWORD=your_cloud_password
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=False
